/* ============================
   BOSCHFLOW - STYLE
============================ */

:root{
    --primary:#2563eb;
    --primary-hover:#1d4ed8;
    --sidebar:#0f172a;
    --sidebar-hover:#1e293b;
    --background:#f1f5f9;
    --white:#ffffff;
    --border:#e2e8f0;
    --text:#1e293b;
    --text-light:#64748b;
    --success:#22c55e;
    --warning:#f59e0b;
    --danger:#ef4444;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Inter,Segoe UI,Arial,sans-serif;
    background:var(--background);
    color:var(--text);
}

.wrapper{
    display:flex;
    min-height:100vh;
}

/* ============================
SIDEBAR
============================ */

.sidebar{
    width:260px;
    background:var(--sidebar);
    color:white;
    position:fixed;
    left:0;
    top:0;
    bottom:0;
    overflow:auto;
}

.logo{
    height:75px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    font-size:24px;
    font-weight:700;
    border-bottom:1px solid rgba(255,255,255,.08);
}

.logo i{
    font-size:28px;
    color:#38bdf8;
}

.sidebar nav{
    padding:20px 0;
}

.sidebar nav a{

    display:flex;

    align-items:center;

    gap:15px;

    color:#cbd5e1;

    text-decoration:none;

    padding:14px 28px;

    transition:.25s;
}

.sidebar nav a:hover{

    background:var(--sidebar-hover);

    color:white;

    padding-left:35px;
}

.sidebar nav i{

    font-size:20px;

    width:24px;
}

/* ============================
CONTENT
============================ */

.content{

    margin-left:260px;

    width:calc(100% - 260px);

    min-height:100vh;
}

/* ============================
TOPBAR
============================ */

.topbar{

    height:75px;

    background:white;

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:0 35px;

    border-bottom:1px solid var(--border);

    position:sticky;

    top:0;

    z-index:999;
}

.topbar h3{

    font-weight:700;
}

.user-info{

    display:flex;

    align-items:center;

    gap:12px;

    font-weight:600;
}

.user-info i{

    font-size:28px;

    color:var(--primary);
}

/* ============================
PAGE
============================ */

.page-content{

    padding:30px;
}

/* ============================
CARDS
============================ */

.card{

    border:none;

    border-radius:18px;

    box-shadow:0 10px 25px rgba(0,0,0,.06);

    transition:.25s;
}

.card:hover{

    transform:translateY(-4px);

    box-shadow:0 18px 35px rgba(0,0,0,.08);
}

.card-title{

    font-weight:700;
}

/* ============================
BOTÕES
============================ */

.btn{

    border-radius:12px;

    padding:10px 18px;

    font-weight:600;
}

.btn-primary{

    background:var(--primary);

    border:none;
}

.btn-primary:hover{

    background:var(--primary-hover);
}

/* ============================
TABLE
============================ */

.table{

    background:white;

    border-radius:15px;

    overflow:hidden;
}

.table thead{

    background:#0f172a;

    color:white;
}

.table td{

    vertical-align:middle;
}

/* ============================
BADGES
============================ */

.badge{

    padding:8px 12px;

    border-radius:50px;

    font-weight:600;
}

/* ============================
FORM
============================ */

.form-control,

.form-select{

    border-radius:10px;

    min-height:45px;
}

.form-control:focus,

.form-select:focus{

    border-color:var(--primary);

    box-shadow:none;
}

/* ============================
ALERTAS
============================ */

.alert{

    border:none;

    border-radius:12px;
}

/* ============================
RESPONSIVO
============================ */

@media(max-width:992px){

.sidebar{

    width:80px;
}

.logo span{

    display:none;
}

.sidebar nav a{

    justify-content:center;

    padding:16px;
}

.sidebar nav a span{

    display:none;
}

.sidebar nav a:hover{

    padding-left:16px;
}

.content{

    margin-left:80px;

    width:calc(100% - 80px);
}

}

@media(max-width:768px){

.topbar{

    padding:20px;
}

.page-content{

    padding:20px;
}

}